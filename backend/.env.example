APP_NAME="Guised Up"
APP_ENV=local
APP_KEY=base64:REPLACE_WITH_php_artisan_key_generate
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=guised_up
DB_USERNAME=root
DB_PASSWORD=

# Python ML Service URL
ML_SERVICE_URL=http://localhost:8001

# Pinecone (configured in ml-service/.env, but document here for reference)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=guised-up-posts

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
